	(text "1  +5V        5 V çıkış (boost, F1 1.1 A PTC)\n2  +3V3       3.3 V çıkış (LDO)\n3  CHRG       açık-drain durum\n4  STDBY      açık-drain durum\n5  BAT_SENSE  analog, VBAT/2\n6  BAT_EN     yüksek = ölçümü aç\n7  BAT_TEMP   analog, pil sıcaklığı\n8  GND"
		(exclude_from_sim no)
		(at 218.44 200.66 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
				(color 90 90 90 1)
			)
			(justify left top)
		)
		(uuid "26eb1240-5c71-4953-9833-bd69a5356a63")
	)
	(text "CHRG STDBY  durum\n  0     0    USB yok (pilden çalışıyor)\n  0     1    şarj oluyor\n  1     0    şarj tamam\n  1     1    USB var, pil yok / sıcaklık hatası\nÇekmeler VBUS'tan (15k/22k ≈ 3.1 V):\nUSB yokken hatlar 0 olur, TP4056'ya sızıntı olmaz"
		(exclude_from_sim no)
		(at 149.86 256.54 0)
		(effects
			(font
				(size 1.27 1.27)
