	(text "1  +5V        5 V çıkış (boost)\n2  +3V3       3.3 V çıkış (LDO)\n3  CHRG       açık-drain durum\n4  STDBY      açık-drain durum\n5  BAT_SENSE  analog, VBAT/2\n6  BAT_EN     yüksek = ölçümü aç\n7  BAT_TEMP   analog, pil sıcaklığı\n8  GND"
		(exclude_from_sim no)
		(at 218.44 200.66 0)
		(effects
