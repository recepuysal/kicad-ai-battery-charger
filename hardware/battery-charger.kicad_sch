	(text "1  +5V        5 V çıkış (boost, F1 1.1 A PTC)\n2  +3V3       3.3 V çıkış (LDO)\n3  CHRG       açık-drain durum\n4  STDBY      açık-drain durum\n5  SDA        I²C veri (MAX17048, 4.7k çekme)\n6  SCL        I²C saat\n7  BAT_TEMP   analog, pil sıcaklığı\n8  GND"
		(exclude_from_sim no)
		(at 218.44 200.66 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
				(color 90 90 90 1)
			)
			(justify left top)
		)
		(uuid "35b718a6-ff21-44ea-86bd-b0f328e02774")
	)
	(text "CHRG STDBY  durum\n  0     0    USB yok (pilden çalışıyor)\n  0     1    şarj oluyor\n  1     0    şarj tamam\n  1     1    USB var, pil yok / sıcaklık hatası\nÇekmeler VBUS'tan (15k/22k ≈ 3.1 V):\nUSB yokken hatlar 0 olur, TP4056'ya sızıntı olmaz"
		(exclude_from_sim no)
		(at 149.86 256.54 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
				(color 90 90 90 1)
			)
			(justify left top)
		)
		(uuid "9b357b33-8883-4c3c-a508-bb4c854da9ba")
	)
